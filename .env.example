# Copy to .env (gitignored). Loaded at import time; does not override shell env already set.

# Test authoring: python or excel (*.xlsx in study folder) — Config/environments.yaml framework.test_case_source
# TEST_CASE_SOURCE=excel

# Target environment and browser (pytest CLI flags win when passed)
ENV=qa
BROWSER=firefox
HEADLESS=false
# HEADED=true          # same as HEADLESS=false

# Red DATA MISMATCH lines during compare (use if pytest capture hides colors)
# FORCE_COLOR=1

# Plain-language UI step lines: [UI] Study facet opened successfully. (default on; set 0 to hide)
# COMMONS_UI_ACTIONS=1

# Memgraph/Neo4j/TSV queries printed when they run: [DB] tab query from … (default on; set 0 to hide)
# COMMONS_DB_QUERIES=1

# CTDC expected data is TSV (no Memgraph password). Optional override of InputFiles/CTDC/tsv:
# CTDC_TSV_ROOT=/path/to/tsv

# HTML suite report → Reports/<Suite>_YYYYMMDD_HHMMSS.html and Reports/latest.html
# HTML_REPORT=true

# Memgraph passwords (gitignored). C3DC and GC use different clusters — never share one password.
#
# C3DC: one password for all envs, OR per-env if your clusters differ:
MEMGRAPH_PASSWORD_C3DC=your-c3dc-memgraph-password
# MEMGRAPH_PASSWORD_C3DC_QA=...
# MEMGRAPH_PASSWORD_C3DC_DEV=...
#
# GC: each pytest --env uses MEMGRAPH_PASSWORD_GC_<ENV> (recommended when passwords differ):
MEMGRAPH_PASSWORD_GC_QA=your-gc-qa-memgraph-password
MEMGRAPH_PASSWORD_GC_QA2=your-gc-qa2-memgraph-password
# MEMGRAPH_PASSWORD_GC_STAGE=...
# MEMGRAPH_PASSWORD_GC_PROD=...
#
# Fallback only if you use one GC password everywhere (unusual):
# MEMGRAPH_PASSWORD_GC=...

# Host/username default from Config/environments.yaml; override only if needed:
# MEMGRAPH_ENDPOINT_C3DC=bolt://...
# MEMGRAPH_USERNAME_C3DC=memgraph

# Bento (Neo4j expected data; UI default from environments.yaml)
# URL_BENTO_QA=https://bento-tools.org/
NEO4J_PASSWORD_BENTO=your-bento-neo4j-password
# NEO4J_PASSWORD_BENTO_QA=...
# NEO4J_ENDPOINT_BENTO=bolt://your-bento-neo4j-host:7687
# NEO4J_USERNAME_BENTO=neo4j
