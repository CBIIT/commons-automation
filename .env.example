# Copy to .env (gitignored). Keep secrets here; non-secret defaults are in
# Config/environments.yaml. Shell variables and pytest CLI flags can still
# override YAML for one run.

# Database passwords are app- and environment-specific.
C3DC_DB_PASSWORD_QA=your-password-here
# C3DC_DB_PASSWORD_DEV=your-password-here
# C3DC_DB_PASSWORD_STAGE=your-password-here
# C3DC_DB_PASSWORD_PROD=your-password-here

GC_DB_PASSWORD_QA=your-password-here
GC_DB_PASSWORD_QA2=your-password-here
# GC_DB_PASSWORD_DEV=your-password-here
# GC_DB_PASSWORD_STAGE=your-password-here
# GC_DB_PASSWORD_PROD=your-password-here

ICDC_DB_PASSWORD_QA=your-password-here
# ICDC_DB_PASSWORD_DEV=your-password-here
# ICDC_DB_PASSWORD_STAGE=your-password-here
# ICDC_DB_PASSWORD_PROD=your-password-here

BENTO_DB_PASSWORD_QA=your-password-here
# BENTO_DB_PASSWORD_DEV=your-password-here
# BENTO_DB_PASSWORD_STAGE=your-password-here
# BENTO_DB_PASSWORD_PROD=your-password-here

# Host/username default from Config/environments.yaml; override only if needed:
# MEMGRAPH_ENDPOINT_C3DC=bolt://...
# MEMGRAPH_USERNAME_C3DC=memgraph

# Endpoint and username overrides remain database-specific.
# URL_BENTO_QA=https://bento-tools.org/
# NEO4J_ENDPOINT_BENTO=bolt://your-bento-neo4j-host:7687
# NEO4J_USERNAME_BENTO=neo4j
