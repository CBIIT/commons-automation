# Copy to .env (gitignored). One Memgraph password per application — clusters are not shared.
MEMGRAPH_PASSWORD_C3DC=your-c3dc-memgraph-password
MEMGRAPH_PASSWORD_GC=your-gc-memgraph-password
# Future apps: MEMGRAPH_PASSWORD_INS=...

# Optional per-env (overrides the line above for that env only):
# MEMGRAPH_PASSWORD_C3DC_QA=...
# MEMGRAPH_PASSWORD_GC_QA2=...

# Host/username default from Config/environments.yaml; override only if needed:
# MEMGRAPH_ENDPOINT_C3DC=bolt://...
# MEMGRAPH_USERNAME_C3DC=memgraph
