# Copy to .env (gitignored). Keep secrets here; non-secret defaults are in
# Config/environments.yaml. Shell variables and pytest CLI flags can still
# override YAML for one run.

# Database passwords are app- and environment-specific.
C3DC_DB_PASSWORD_QA=your-c3dc-qa-password
# C3DC_DB_PASSWORD_DEV=...
# C3DC_DB_PASSWORD_STAGE=...
# C3DC_DB_PASSWORD_PROD=...

GC_DB_PASSWORD_QA=your-gc-qa-password
GC_DB_PASSWORD_QA2=your-gc-qa2-password
# GC_DB_PASSWORD_DEV=...
# GC_DB_PASSWORD_STAGE=...
# GC_DB_PASSWORD_PROD=...

ICDC_DB_PASSWORD_QA=your-icdc-qa-password
# ICDC_DB_PASSWORD_DEV=...
# ICDC_DB_PASSWORD_STAGE=...
# ICDC_DB_PASSWORD_PROD=...

BENTO_DB_PASSWORD_QA=your-bento-qa-password
# BENTO_DB_PASSWORD_DEV=...
# BENTO_DB_PASSWORD_STAGE=...
# BENTO_DB_PASSWORD_PROD=...

# Host/username default from Config/environments.yaml; override only if needed:
# MEMGRAPH_ENDPOINT_C3DC=bolt://...
# MEMGRAPH_USERNAME_C3DC=memgraph

# Endpoint and username overrides remain database-specific.
# URL_BENTO_QA=https://bento-tools.org/
# NEO4J_ENDPOINT_BENTO=bolt://your-bento-neo4j-host:7687
# NEO4J_USERNAME_BENTO=neo4j
